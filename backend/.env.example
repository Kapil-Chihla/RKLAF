PORT=5000
# MongoDB Atlas (or local): mongodb+srv://user:pass@cluster.mongodb.net/rklaf
MONGODB_URI=mongodb://127.0.0.1:27017/rklaf

# Production: https://your-project.vercel.app (no trailing slash)
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-secret

# Cloudinary (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — contact / ask / donate inquiry forms → organisation inbox
# Preferred on Render: Resend HTTPS (Gmail SMTP often times out / is blocked)
# https://resend.com → API Keys. Sign up with the org Gmail so free-tier "to" works.
RESEND_API_KEY=
# Until you verify a custom domain, use Resend's test sender:
RESEND_FROM=RKLAF Website <onboarding@resend.dev>
CONTACT_RECEIVER_EMAIL=radheykrishnalegalaid@gmail.com

# Optional fallback (local / hosts that allow outbound SMTP)
# Use a Gmail App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=radheykrishnalegalaid@gmail.com
SMTP_PASS=
SMTP_FROM=radheykrishnalegalaid@gmail.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
